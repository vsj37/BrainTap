{
	"name": "braintap",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "braintap",
			"database_id": "be9f30bf-7a38-46b5-96b1-e1576218ab3b"
		}
		
	]
}